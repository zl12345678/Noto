    "md-editor-v3": "^5.8.5",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@types/node": "^22.15.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "typescript": "^5.8.3",
