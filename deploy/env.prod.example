# 云服务器 .env 示例（复制到项目根目录 .env 后修改）

POSTGRES_DB=noto_zhihui
POSTGRES_USER=postgres
POSTGRES_PASSWORD=请改为强密码

NOTO_JWT_SECRET=请改为至少32字符的随机字符串
NOTO_DEMO_ENABLED=false
NOTO_AI_ENABLED=true
AI_DASHSCOPE_API_KEY=你的百炼Key

NOTO_MINIO_ENABLED=true
MINIO_ROOT_USER=noto_minio
MINIO_ROOT_PASSWORD=请改为强密码

# 仅本机访问，由宿主机 Nginx 对外暴露 443。
# 如需飞牛 OS / 家庭 IPv6 高端口直连，可在生产 .env 中改为 FRONTEND_HOST=[::]、FRONTEND_PORT=18080。
BACKEND_PORT=9086
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8080
