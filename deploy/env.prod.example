# 云服务器 .env 示例（复制到项目根目录 .env 后修改）

POSTGRES_DB=noto_zhihui
POSTGRES_USER=postgres
POSTGRES_PASSWORD=请改为强密码

NOTO_JWT_SECRET=请改为至少32字符的随机字符串
NOTO_DEMO_ENABLED=false
# 如需对外演示，建议启用独立 demo 账号，避免污染个人 admin 数据：
# NOTO_DEMO_ENABLED=true
# NOTO_DEMO_USERNAME=demo
# NOTO_DEMO_PASSWORD=请改为演示账号密码
# NOTO_DEMO_EMAIL=demo@noto.local
# NOTO_DEMO_NICKNAME=演示账号
# NOTO_DEMO_CREATE_USER=true
# NOTO_DEMO_RESET_PASSWORD=true
NOTO_AI_ENABLED=true
AI_DASHSCOPE_API_KEY=你的百炼Key

NOTO_MINIO_ENABLED=true
MINIO_ROOT_USER=noto_minio
MINIO_ROOT_PASSWORD=请改为强密码

# 仅本机访问，由宿主机 Nginx 对外暴露 443。
# 如需飞牛 OS / 家庭服务器直接监听公网/局域网，可在生产 .env 中改为：
#   FRONTEND_IPV4_HOST=0.0.0.0
#   FRONTEND_IPV6_HOST=[::]
#   FRONTEND_PORT=80
BACKEND_PORT=9086
FRONTEND_IPV4_HOST=127.0.0.1
FRONTEND_IPV6_HOST=[::1]
FRONTEND_PORT=8080
